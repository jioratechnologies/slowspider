# Root .dockerignore — applies to every build whose context is "." (apps/backend's and
# apps/web's Dockerfiles, see docker-compose.yaml). Keeps the build context small and, more
# importantly, keeps apps/mobile/apps/android (never built into either image) and every
# workspace's own node_modules out of it — each Dockerfile explicitly COPYs only the
# package.json files + source it actually needs.
node_modules
**/node_modules
apps/mobile
apps/android
apps/backend/dist
apps/backend/.env
apps/backend/.env.*
apps/web/.next
apps/web/.env
apps/web/.env.*
packages/shared-types/dist
# Stale local incremental-build caches — if copied in without their matching dist/ output
# (which is excluded above), tsc/nest build reads them, believes it's already up to date, and
# silently skips emitting anything. Bit us once already getting this Dockerfile working.
**/*.tsbuildinfo
.git
.next
docs
infra
*.md

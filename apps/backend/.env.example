# Same physical Postgres/Redis/Storage as apps/web — Phase 1 of the migration plan runs the
# backend alongside the Next.js monolith against the same infra, just via its own env file.
# Renamed from apps/web's NEXT_PUBLIC_-prefixed vars where noted; the backend has no
# client-bundling convention that would require the NEXT_PUBLIC_ prefix.

# Supabase project (renamed from NEXT_PUBLIC_SUPABASE_URL)
SUPABASE_URL=
# Publishable/anon key (renamed from NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY) — used to verify
# bearer tokens (auth.getUser) and for per-request RLS-scoped clients.
SUPABASE_PUBLISHABLE_KEY=
# Service-role key — bypasses RLS, used only where the app already did (workspace
# bootstrapping, board reads, the cron job). Server-only, never sent to a client.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — Prisma schema/migrations only (this app queries via Supabase-js like apps/web
# does; Prisma is not in the runtime query path, see prisma/schema.prisma).
DATABASE_URL=
DIRECT_URL=

# Redis (ioredis) — OTP storage + rate limiting
REDIS_URL=

# Auth flow
AUTH_MODE=dev
DEV_OTP_CODE=123456

# Email (Resend) — OTP + workspace invite emails
RESEND_API_KEY=
EMAIL_FROM="Slow Spider <onboarding@resend.dev>"

# Used to build the invite-accept link in invite emails (equivalent of apps/web's
# NEXT_PUBLIC_APP_URL). Not in the task's required key list but needed by the ported
# sendInviteEmail — falls back to http://localhost:3000 if unset, same as apps/web.
APP_URL=http://localhost:3000

# Optional — if set, GET /cron/cold-storage requires `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# Port the Nest HTTP server listens on
PORT=3001

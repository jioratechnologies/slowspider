// Schema/migration management only — Prisma is not used for runtime queries. The app's
// actual reads/writes go through a per-request Supabase client scoped to the caller's own
// access token (src/lib/services/board.ts etc.), which is what makes Postgres RLS the real
// workspace-access boundary. Prisma Client here would connect with one fixed connection
// string and can't hold a per-user RLS session, so it's kept out of the request path.
//
// This file describes the FINAL target shape (after scripts/migrate-users-to-supabase-auth.ts
// has run and the cleanup migration has dropped the legacy columns) — see
// prisma/migrations/README for why the migration history doesn't match this file 1:1 at
// every intermediate step.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "auth"]
}

/// Supabase-managed — not created or altered by our migrations, referenced only so `users`
/// below can declare its FK.
model AuthUser {
  id String @id @db.Uuid

  profile User?

  @@map("users")
  @@schema("auth")
}

model User {
  id        String   @id @db.Uuid
  email     String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  authUser        AuthUser          @relation(fields: [id], references: [id], onDelete: Cascade)
  ownedWorkspaces Workspace[]       @relation("WorkspaceOwner")
  memberships     WorkspaceMember[]
  sentInvites     WorkspaceInvite[] @relation("Inviter")
  settings        UserSettings[]

  @@map("users")
  @@schema("public")
}

model Workspace {
  id        BigInt   @id @default(autoincrement())
  name      String   @default("My Workspace")
  ownerId   String   @map("owner_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  owner      User              @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members    WorkspaceMember[]
  invites    WorkspaceInvite[]
  categories Category[]
  clusters   Cluster[]
  tasks      Task[]
  milestones Milestone[]
  notes      Note[]
  settings   UserSettings[]

  @@map("workspaces")
  @@schema("public")
}

model WorkspaceMember {
  workspaceId BigInt   @map("workspace_id")
  userId      String   @map("user_id") @db.Uuid
  role        String   @default("editor") // "owner" | "editor"
  joinedAt    DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
  @@schema("public")
}

model WorkspaceInvite {
  id          BigInt   @id @default(autoincrement())
  workspaceId BigInt   @map("workspace_id")
  email       String
  invitedBy   String   @map("invited_by") @db.Uuid
  token       String   @unique
  status      String   @default("pending") // "pending" | "accepted" | "revoked" | "expired" | "declined"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inviter   User      @relation("Inviter", fields: [invitedBy], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("workspace_invites")
  @@schema("public")
}

model Category {
  id          BigInt   @id @default(autoincrement())
  workspaceId BigInt   @map("workspace_id")
  createdBy   String?  @map("created_by") @db.Uuid
  name        String
  color       String
  pos         Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clusters  Cluster[]

  @@index([workspaceId])
  @@map("categories")
  @@schema("public")
}

model Cluster {
  id          BigInt    @id @default(autoincrement())
  workspaceId BigInt    @map("workspace_id")
  createdBy   String?   @map("created_by") @db.Uuid
  name        String
  color       String
  categoryId  BigInt?   @map("category_id")
  status      String    @default("active") // "active" | "cold" | "binned"
  binnedAt    DateTime? @map("binned_at") @db.Timestamptz(6)
  lastUsedAt  DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(6)
  pos         Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  tasks     Task[]
  notes     Note[]

  @@index([workspaceId])
  @@index([categoryId])
  @@map("clusters")
  @@schema("public")
}

model Task {
  id          BigInt    @id @default(autoincrement())
  workspaceId BigInt    @map("workspace_id")
  createdBy   String?   @map("created_by") @db.Uuid
  clusterId   BigInt?   @map("cluster_id")
  title       String    @default("")
  priority    String    @default("none") // "high" | "med" | "low" | "none"
  starred     Boolean   @default(false)
  deadline    DateTime? @db.Date
  /// "HH:MM" — only tasks carrying a time are eligible for calendar sync.
  deadlineTime String?  @map("deadline_time")
  notes       String    @default("")
  done        Boolean   @default(false)
  cold        Boolean   @default(false)
  binned      Boolean   @default(false)
  binnedAt    DateTime? @map("binned_at") @db.Timestamptz(6)
  pos         Float     @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  workspace  Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cluster    Cluster?    @relation(fields: [clusterId], references: [id], onDelete: Cascade)
  milestones Milestone[]
  notes      Note[]

  @@index([workspaceId])
  @@index([clusterId])
  @@index([deadline], map: "tasks_open_deadline_idx")
  @@map("tasks")
  @@schema("public")
}

model Milestone {
  id          BigInt  @id @default(autoincrement())
  workspaceId BigInt  @map("workspace_id")
  taskId      BigInt  @map("task_id")
  title       String
  done        Boolean @default(false)
  pos         Int     @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([taskId])
  @@map("milestones")
  @@schema("public")
}

/// Rich note attached to exactly one parent — a task or a cluster (DB check constraint
/// enforces "exactly one"). A `private` note is invisible to every other workspace member,
/// enforced by RLS rather than app code.
model Note {
  id          BigInt   @id @default(autoincrement())
  workspaceId BigInt   @map("workspace_id")
  taskId      BigInt?  @map("task_id")
  clusterId   BigInt?  @map("cluster_id")
  createdBy   String   @map("created_by") @db.Uuid
  kind        String   @default("text") // text | rich | code | link | image | video | voice | table
  visibility  String   @default("workspace") // "workspace" | "private"
  body        String   @default("")
  url         String?
  mime        String?
  sizeBytes   BigInt   @default(0) @map("size_bytes")
  durationMs  Int?     @map("duration_ms")
  pos         Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  cluster   Cluster?  @relation(fields: [clusterId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([clusterId])
  @@index([workspaceId])
  @@index([createdBy])
  @@map("notes")
  @@schema("public")
}

model UserSettings {
  id          BigInt @id @default(autoincrement())
  userId      String @map("user_id") @db.Uuid
  workspaceId BigInt @map("workspace_id")
  sortMode    String @default("smart") @map("sort_mode") // "smart" | "manual"

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@map("user_settings")
  @@schema("public")
}
